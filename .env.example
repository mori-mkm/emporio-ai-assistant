# Reference only: the backend reads PROCESS environment variables and does not load .env files.
# Set them in the PowerShell session that starts the backend (see docs/development.md).
# Never commit real values.

# Assistant mode. Unset = chat disabled (no mock, no paid calls); /api/health still works.
#   simulated = offline scripted provider, labelled in the UI; live = paid API (default provider
#   anthropic = Claude Haiku 5.5; openai = GPT-6 Luna); local = Ollama qwen3:8b on this machine.
EMPORIO_ASSISTANT_MODE=
# Backend-only provider choice (clients cannot select it). Unset = the mode's default.
# EMPORIO_PROVIDER=anthropic
# Anthropic only: off (default) or system-5m (one explicit 5-minute cache breakpoint).
# EMPORIO_PROMPT_CACHE=off
# Local mode only; must be a loopback http address.
# EMPORIO_OLLAMA_URL=http://127.0.0.1:11434

# Live mode only. Read by the backend process; never sent to the browser or logged.
ANTHROPIC_API_KEY=<your-key-here>
OPENAI_API_KEY=<your-key-here>

# Optional overrides. Paths default to these locations under the repository root;
# a relative override is resolved from the backend process's working directory.
# EMPORIO_DATA_DIR=<repo>/data/derived
# EMPORIO_LEDGER_PATH=<repo>/data/budget/ledger.sqlite
# EMPORIO_PRICING_PATH=<repo>/config/pricing.json
EMPORIO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EMPORIO_COOKIE_SECURE=false
